DATABASE_URL=postgres://tutor:<password>@127.0.0.1:5440/tutor
# Leave R2_* unset to store photos in LOCAL_STORAGE_DIR
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tutor-photos
LOCAL_STORAGE_DIR=./data
PORT=8080
# From `claude setup-token`; not needed locally if you are signed in to Claude Code
CLAUDE_CODE_OAUTH_TOKEN=
WEB_ORIGIN=http://localhost:3000
