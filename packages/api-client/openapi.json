  "components": {
    "schemas": {
      "Diagram": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "redraw_note": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "description": "queued, drawing, done or failed."
          },
          "svg_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "API path of the SVG; present when status is done."
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Exam": {
        "type": "object",
        "required": [
          "id",
          "body",
          "code",
          "name",
          "level"
        ],
        "properties": {
          "body": {
            "type": "string",
            "description": "WAEC, NECO, NABTEB or JAMB."
          },
          "code": {
            "type": "string",
            "description": "WASSCE, SSCE, BECE, NBC or UTME."
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "level": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "GroupEdit": {
        "type": "object",
        "properties": {
          "display_instruction": {
            "type": [
              "string",
              "null"
            ],
            "description": "Student-facing instruction; must not mention question numbers."
          }
        }
      },
      "GroupMember": {
        "type": "object",
        "required": [
          "id",
          "number",
          "needs_check"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "needs_check": {
            "type": "boolean"
          },
          "number": {
            "type": "string"
          },
          "resolved_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "database",
          "storage",
          "claude",
          "openai"
        ],
        "properties": {
          "claude": {
            "type": "string"
          },
          "database": {
            "type": "string"
          },
          "openai": {
            "type": "string"
          },
          "storage": {
            "type": "string"
          }
        }
      },
      "OptionDetail": {
        "type": "object",
        "required": [
          "id",
          "label",
          "is_correct"
        ],
        "properties": {
          "body": {
            "type": [
              "string",
              "null"
            ]
          },
          "diagram": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Diagram"
              }
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "is_correct": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "OptionEdit": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "body": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "PageDetail": {
        "type": "object",
        "required": [
          "page",
          "photo_url",
          "questions"
        ],
        "properties": {
          "page": {
            "$ref": "#/components/schemas/PageSummary"
          },
          "photo_url": {
            "type": "string",
            "description": "API path of the original photo."
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionSummary"
            }
          },
          "tail_fragment": {
            "type": [
              "string",
              "null"
            ],
            "description": "The question this page ends with that runs onto the next page, until joined."
          }
        }
      },
      "PageSummary": {
        "type": "object",
        "required": [
          "id",
          "source_id",
          "source",
          "subject_id",
          "subject",
          "status",
          "attempts",
          "uploaded_at",
          "question_count",
          "flagged_count",
          "waiting_for_next_page"
        ],
        "properties": {
          "attempts": {
            "type": "integer",
            "format": "int32"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "flagged_count": {
            "type": "integer",
            "format": "int64"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "next_attempt_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "page_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "processed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "question_count": {
            "type": "integer",
            "format": "int64"
          },
          "source": {
            "type": "string"
          },
          "source_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "description": "queued, processing, done or failed."
          },
          "subject": {
            "type": "string"
          },
          "subject_id": {
            "type": "string",
            "format": "uuid"
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time"
          },
          "waiting_for_next_page": {
            "type": "boolean",
            "description": "The last question runs onto the next page, which hasn't been processed yet."
          }
        }
      },
      "QuestionDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/QuestionSummary"
          },
          {
            "type": "object",
            "required": [
              "options"
            ],
            "properties": {
              "confidence": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "gpt-6.1-sol's confidence in the saved answer."
              },
              "diagram": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/Diagram",
                    "description": "The question's own diagram, or the shared one from its group."
                  }
                ]
              },
              "explanation": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "group": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/QuestionGroup",
                    "description": "The group this question belongs to; its questions are always shown together."
                  }
                ]
              },
              "next_flagged_id": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid",
                "description": "Next flagged, unresolved question in book order (for \"Looks right → next\")."
              },
              "options": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/OptionDetail"
                }
              },
              "photo_url": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Photo of the page it was first seen on; none for our own questions."
              },
              "second_answer": {
                "type": [
                  "string",
                  "null"
                ],
