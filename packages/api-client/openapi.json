                }
              }
            }
          }
        }
      }
    },
    "/queue/resume": {
      "post": {
        "tags": [],
        "summary": "Resumes a hand pause and also retries straight away after a usage-limit pause.",
        "operationId": "resume_queue",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
